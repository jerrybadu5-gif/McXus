# Copy to backend/.env and adjust. Never commit the real .env.
MCXUS_ENV=dev                       # dev | test | prod
MCXUS_DATABASE_URL=postgresql+psycopg://mcxus:mcxus@localhost:5433/mcxus
MCXUS_JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars
MCXUS_OTP_SECRET=change-me-to-another-long-random-value
MCXUS_JWT_MINUTES=60
MCXUS_CORS_ORIGINS=["http://localhost:5173"]

# Sandbox: test Stars only. Must stay true until a licensed issuer partner is live.
MCXUS_SANDBOX_MODE=true
MCXUS_SANDBOX_TOPUP_MAX=1000.00

# Escrow timers
MCXUS_SELLER_ACCEPT_MINUTES=20
MCXUS_AUTO_RELEASE_DAYS=7
MCXUS_HANDOVER_PIN_MAX_ATTEMPTS=5

# Fees (1 Star = 1 PGK)
MCXUS_ESCROW_FEE_RATE=0.03
MCXUS_ESCROW_FEE_MIN=1.00
MCXUS_ESCROW_FEE_MAX=150.00
MCXUS_CANCEL_FEE_RATE=0.05
MCXUS_CANCEL_FEE_MIN=2.00
MCXUS_CANCEL_FEE_COUNTERPARTY_SHARE=0.50
MCXUS_WITHDRAWAL_FEE=2.00

# Sign-in codes
MCXUS_OTP_TTL_MINUTES=5
MCXUS_OTP_MAX_ATTEMPTS=5
MCXUS_OTP_MAX_PER_10_MIN=3

MCXUS_WORKER_INTERVAL_SECONDS=30
